# Bitget requires no API keys. Server-side ticker freshness threshold in milliseconds (optional, default 60000).
MARKET_STALE_AFTER_MS=60000

# Alpaca Market Data credentials: server-side only. Never prefix with NEXT_PUBLIC.
APCA_API_KEY_ID=
APCA_API_SECRET_KEY=

# Optional AI Research Synthesis Engine (deterministic fallback active if omitted)
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
